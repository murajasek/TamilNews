# Arathamizh - Vercel environment example
#
# This app does not require API keys for Vercel deployment.
# News is fetched by the built-in Next.js API routes from public publisher feeds/pages.

# Optional: public site URL used by external tooling or future metadata integrations.
NEXT_PUBLIC_SITE_URL=https://arathamizh.com

# Optional: Vercel provides this automatically at runtime for preview/production deployments.
# VERCEL_URL=your-project-name.vercel.app

# Optional: PortfoliUp URL shown in the home page footer (defaults to http://127.0.0.1:8765/).
# NEXT_PUBLIC_PORTFOLIUP_URL=https://your-portfoliup-url.example.com

# Local-only / GoDaddy bridge variable. Not required on Vercel.
# NEXT_APP_URL=https://your-node-app.example.com
